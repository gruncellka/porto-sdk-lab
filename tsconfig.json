{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "lib": ["ES2022"],
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "paths": {
            "@gruncellka/porto-sdk": ["./sdks/porto-sdk-typescript/src/index.ts"],
            "@gruncellka/porto-sdk/*": ["./sdks/porto-sdk-typescript/src/*"]
        }
    },
    "include": [
        "labs/typescript/**/*.ts",
        "sdks/porto-sdk-typescript/**/*.ts"
    ],
    "exclude": ["**/node_modules", "**/dist", "**/build", "**/*.test.ts"]
}
