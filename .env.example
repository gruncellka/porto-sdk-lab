# Porto SDK Lab — copy to `.env` (gitignored). One root file; shared by both Docker labs.
# Paid matrix: make labs-internetmarke-* · docs: labs/experiments/internetmarke/README.md

# --- Required: Deutsche Post / Internetmarke ---
PORTO_DEUTSCHEPOST_INTERNETMARKE_BASE_URL=https://api-eu.dhl.com/post/de/shipping/im/v1
PORTO_DEUTSCHEPOST_INTERNETMARKE_USERNAME=
PORTO_DEUTSCHEPOST_INTERNETMARKE_PASSWORD=
PORTO_DEUTSCHEPOST_INTERNETMARKE_API_KEY=
PORTO_DEUTSCHEPOST_INTERNETMARKE_API_SECRET=
# PORTO_DEUTSCHEPOST_INTERNETMARKE_PARTNER_ID=

# --- Optional: SDK ---
# PORTO_PROVIDER=deutschepost
# PORTO_DATA_PATH=
# PORTO_TIMEOUT_MS=30000
# PORTO_RETRIES=3

# --- Optional: lab / observer (make labs-internetmarke-* sets most of these) ---
# PORTO_LAB_HTTP_TRACE=1
# PORTO_LAB_HTTP_TRACE_DIR=
# PROFILE=canary
# DRY_RUN=1
# MAX_CASES=3
# OBSERVER_KEEP_LAST_RUNS=30
